{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kylemcd-com",
	"preview_urls": true,
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"DEV_FRESH_DATA": "false",
		"KV_READ_ONLY_CACHE": "false",
		"KV_ENABLE_LOOKUP_STATUS_WRITES": "false"
	},
	"main": "./worker.ts",
	"routes": [
		{ "pattern": "kpm.sh", "custom_domain": true },
		{ "pattern": "www.kpm.sh", "custom_domain": true },
		{ "pattern": "kylemcd.com", "custom_domain": true },
		{ "pattern": "www.kylemcd.com", "custom_domain": true }
	],
	"kv_namespaces": [
		{
			"binding": "APP_STORE",
			"id": "80244ef92fd3460587eca71c1c482b07",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "RACING_MEDIA",
			"bucket_name": "kpm-racing-media",
			"remote": true
		}
	],
	"services": [
		{
			"binding": "PUBLISHED_CONTENT",
			"service": "arsenal-share",
			"remote": true
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "published-content-updates",
				"max_batch_size": 100,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "published-content-updates-dlq",
				"max_concurrency": 1
			}
		]
	},
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"workflows": [
		{
			"binding": "GARAGE61_REFRESH_WORKFLOW",
			"name": "refresh-garage61",
			"class_name": "RefreshGarage61Workflow"
		},
		{
			"binding": "GOODREADS_REFRESH_WORKFLOW",
			"name": "refresh-goodreads",
			"class_name": "RefreshGoodreadsWorkflow"
		},
		{
			"binding": "LASTFM_REFRESH_WORKFLOW",
			"name": "refresh-lastfm",
			"class_name": "RefreshLastFmWorkflow"
		},
		{
			"binding": "SETLISTFM_REFRESH_WORKFLOW",
			"name": "refresh-setlistfm",
			"class_name": "RefreshSetlistFmWorkflow"
		},
		{
			"binding": "STALE_MONITOR_WORKFLOW",
			"name": "stale-data-monitor",
			"class_name": "StaleDataMonitorWorkflow"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["GenreObservationCollector"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["GenreObservationCollector"]
		}
	],
	"triggers": {
		"crons": ["0,30 * * * *"]
	},
	"limits": {
		"cpu_ms": 300000,
		"subrequests": 50000
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}
