{
	"name": "kpm-sh",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "zsh -lc 'set -a; source .env; set +a; DEV_FRESH_DATA=true vite dev --host 0.0.0.0 --port 3000'",
		"dev:sandbox": "bash -lc 'CERT=${NIX_SSL_CERT_FILE:-/etc/ssl/certs/ca-bundle.crt}; export SSL_CERT_FILE=\"$CERT\"; export NODE_EXTRA_CA_CERTS=\"$CERT\"; set -a; source .env; set +a; DEV_FRESH_DATA=true vite dev --host 0.0.0.0 --port 3001'",
		"dev:prod": "zsh -lc 'set -a; source .env; set +a; DEV_FRESH_DATA=false KV_READ_ONLY_CACHE=true vite dev --host 0.0.0.0 --port 3000'",
		"build": "vite build",
		"serve": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"tracks:sync": "node scripts/sync-iracing-track-maps.mjs",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"deploy": "wrangler deploy",
		"og": "vite-node --config vite.og.config.ts src/lib/open-graph/index.tsx"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@hackernoon/pixel-icon-library": "^1.1.0",
		"@markdoc/markdoc": "^0.5.9",
		"@paper-design/shaders-react": "^0.0.80",
		"@tanstack/charts": "0.16.0",
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-start": "^1.168.49",
		"better-result": "^3.0.1",
		"d3-shape": "^3.2.0",
		"fast-xml-parser": "^5.11.1",
		"js-yaml": "^5.4.1",
		"match-sorter": "^8.3.0",
		"mermaid": "^11.17.2",
		"prismjs": "^1.30.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"slugify": "^1.6.9",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@cloudflare/vite-plugin": "^1.54.2",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.3",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^26.4.0",
		"@types/prismjs": "^1.26.6",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^29.1.1",
		"satori": "^0.33.4",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-node": "^6.0.0",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.1"
	}
}
